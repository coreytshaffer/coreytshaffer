{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pc-eer-0.1.schema.json",
  "title": "Philosophical Council epistemic evaluation record (pc-eer/0.1, proposed)",
  "description": "Proposed, not accepted, not implemented. Structural schema for one evaluation of one case packet by one study condition. It records what reviewers reported and a synthesis that preserves every position. It carries no decision, approval or truth field. Semantic rules that JSON Schema cannot express (quote matching, cross-references, synthesis coverage) are listed in epistemic-evaluation-record.md section 6. Defect codes are not part of this record: they are assigned later by human adjudication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_format",
    "record_id",
    "record_status",
    "created_at",
    "non_claims",
    "study_context",
    "packet",
    "lineage",
    "reviewers",
    "findings",
    "reviewer_assessments",
    "synthesis",
    "integrity"
  ],
  "properties": {
    "record_format": { "const": "pc-eer/0.1-proposed" },
    "record_id": { "$ref": "#/$defs/token" },
    "record_status": {
      "enum": ["illustrative_example", "study_record"],
      "description": "illustrative_example: hand-written to explain the format; contains no model output and is not a result."
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "non_claims": {
      "description": "Constant non-claims carried in the data itself. A record cannot certify truth, safety or intent, confer authority, or claim to represent anyone.",
      "type": "object",
      "additionalProperties": false,
      "required": ["truth", "safety", "intent", "authority", "representation"],
      "properties": {
        "truth": { "const": "not_assessed" },
        "safety": { "const": "not_assessed" },
        "intent": { "const": "not_assessed" },
        "authority": { "const": "none" },
        "representation": { "const": "none" }
      }
    },
    "study_context": {
      "description": "Null for illustrative examples.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["study_id", "protocol_revision", "condition", "replicate"],
          "properties": {
            "study_id": { "$ref": "#/$defs/token" },
            "protocol_revision": { "type": "string", "minLength": 1 },
            "condition": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
            "replicate": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "packet": {
      "description": "Identity of the exact case packet bytes every reviewer received. The subject artifact is segment family A inside this packet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "path", "sha256"],
      "properties": {
        "case_id": { "$ref": "#/$defs/case_id" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "transformations"],
      "properties": {
        "declared": {
          "description": "Mechanical projection of the packet's declared derived_from metadata. Declared lineage is a source assertion, not verified dependence.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "derived_from", "declared_roots"],
            "properties": {
              "source_id": { "$ref": "#/$defs/source_id" },
              "derived_from": { "type": "array", "items": { "$ref": "#/$defs/source_id" }, "uniqueItems": true },
              "declared_roots": { "type": "array", "items": { "$ref": "#/$defs/source_id" }, "uniqueItems": true, "minItems": 1 }
            }
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transformation_id", "output_id", "standing_ceiling_source_ids", "fidelity_check", "standing_effects_reported"],
            "properties": {
              "transformation_id": { "$ref": "#/$defs/transformation_id" },
              "output_id": { "$ref": "#/$defs/source_id" },
              "standing_ceiling_source_ids": {
                "description": "The output may not carry more evidentiary standing than these sources.",
                "type": "array",
                "items": { "$ref": "#/$defs/source_id" },
                "minItems": 1,
                "uniqueItems": true
              },
              "fidelity_check": { "$ref": "#/$defs/fidelity_check" },
              "standing_effects_reported": {
                "description": "Effects reviewers reported, each tied to the findings that reported it. Empty means none was reported, not that none occurred.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["effect", "finding_ids"],
                  "properties": {
                    "effect": { "$ref": "#/$defs/standing_effect" },
                    "finding_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "kind",
          "procedure",
          "model",
          "independence_class",
          "packet_sha256",
          "prompt_sha256",
          "output_sha256",
          "budget",
          "submitted_before_synthesis"
        ],
        "properties": {
          "reviewer_id": { "$ref": "#/$defs/token" },
          "kind": { "enum": ["model", "human", "illustrative_placeholder"] },
          "procedure": {
            "description": "generic: ordinary critique (C1, C3). O1..O6: one operator (C4). O1-O6_sequential: all operators in one context (C2). naive: C0 exploratory baseline.",
            "enum": ["generic", "naive", "O1", "O2", "O3", "O4", "O5", "O6", "O1-O6_sequential"]
          },
          "model": {
            "description": "Immutable model identity. Mutable aliases may appear only as supplementary labels.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "exact_version", "alias_labels", "settings"],
                "properties": {
                  "family": { "type": "string", "minLength": 1 },
                  "exact_version": { "type": "string", "minLength": 1 },
                  "alias_labels": { "type": "array", "items": { "type": "string" } },
                  "settings": {
                    "description": "Sampling and reasoning settings, values recorded as strings.",
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            ]
          },
          "independence_class": { "$ref": "#/$defs/independence_class" },
          "packet_sha256": { "$ref": "#/$defs/sha256" },
          "prompt_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
          "output_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_output_tokens", "used_output_tokens", "used_input_tokens"],
            "properties": {
              "max_output_tokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
              "used_output_tokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
              "used_input_tokens": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
            }
          },
          "submitted_before_synthesis": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "model" } } },
            "then": { "properties": { "model": { "type": "object" } } }
          },
          {
            "if": { "properties": { "kind": { "enum": ["human", "illustrative_placeholder"] } } },
            "then": { "properties": { "model": { "type": "null" } } }
          }
        ]
      }
    },
    "findings": {
      "description": "Every finding exactly as reported, attributed to one reviewer. No deduplication or rewording.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "reviewer_id", "segments", "observations", "interpretation", "severity", "confidence_pct", "verification_requests"],
        "properties": {
          "finding_id": { "$ref": "#/$defs/token" },
          "reviewer_id": { "$ref": "#/$defs/token" },
          "segments": { "type": "array", "items": { "$ref": "#/$defs/segment_id" }, "minItems": 1, "uniqueItems": true },
          "observations": {
            "description": "What the packet says: exact quotations, mechanically checkable. Interpretation lives only in the interpretation field.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segment_id", "quote", "quote_verified"],
              "properties": {
                "segment_id": { "$ref": "#/$defs/segment_id" },
                "quote": { "type": "string", "minLength": 1 },
                "quote_verified": {
                  "description": "true: exact substring of the cited segment. false: not found (warn-and-review: retained and flagged). null: not yet checked.",
                  "type": ["boolean", "null"]
                }
              }
            }
          },
          "interpretation": { "type": "string", "minLength": 1 },
          "severity": { "$ref": "#/$defs/severity" },
          "confidence_pct": { "$ref": "#/$defs/pct" },
          "verification_requests": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "reviewer_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "support_assessment", "confidence_pct", "rationale", "supportable_reformulation"],
        "properties": {
          "reviewer_id": { "$ref": "#/$defs/token" },
          "support_assessment": { "$ref": "#/$defs/support_assessment" },
          "confidence_pct": { "$ref": "#/$defs/pct" },
          "rationale": { "type": "string", "minLength": 1 },
          "supportable_reformulation": { "type": ["string", "null"] }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "positions",
        "unresolved_disagreements",
        "segment_attention",
        "agreement_is_not_corroboration",
        "dropped_positions",
        "synthesized_confidence"
      ],
      "properties": {
        "method": { "enum": ["single_reviewer", "mechanical_union", "model_synthesis"] },
        "positions": {
          "description": "Every distinct reviewer support assessment, with who holds it. Listing a position retains it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position_id", "support_assessment", "held_by"],
            "properties": {
              "position_id": { "$ref": "#/$defs/token" },
              "support_assessment": { "$ref": "#/$defs/support_assessment" },
              "held_by": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true }
            }
          }
        },
        "unresolved_disagreements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disagreement_id", "position_ids", "type", "note"],
            "properties": {
              "disagreement_id": { "$ref": "#/$defs/token" },
              "position_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 2, "uniqueItems": true },
              "type": {
                "description": "integrity_conflict: records inconsistent with each other (not an opinion). reasoned / framework_dependent: competing assessments, both retained. unclassified: mechanical synthesis does not classify.",
                "enum": ["unclassified", "reasoned", "framework_dependent", "integrity_conflict"]
              },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "segment_attention": {
          "description": "Which reviewers cited each segment. A count of reviewers is attention, not corroboration.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "reviewer_ids", "independence_classes"],
            "properties": {
              "segment_id": { "$ref": "#/$defs/segment_id" },
              "reviewer_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true },
              "independence_classes": { "type": "array", "items": { "$ref": "#/$defs/independence_class" }, "minItems": 1, "uniqueItems": true }
            }
          }
        },
        "agreement_is_not_corroboration": {
          "description": "Constant in v0.1. Agreement among reviewers is never recorded as independent corroboration; any corroboration claim needs a separate dependence analysis.",
          "const": true
        },
        "dropped_positions": {
          "description": "Must be empty for single_reviewer and mechanical_union. For model_synthesis, any reviewer position missing from positions is listed here with a justification so the omission stays inspectable.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["support_assessment", "held_by", "justification"],
            "properties": {
              "support_assessment": { "$ref": "#/$defs/support_assessment" },
              "held_by": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true },
              "justification": { "type": "string", "minLength": 1 }
            }
          }
        },
        "synthesized_confidence": {
          "description": "Constant null in v0.1: confidence is never aggregated across reviewers, so agreement cannot inflate it. Per-reviewer confidence stays on findings and assessments.",
          "const": null
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_hash_consistent", "unverified_quote_finding_ids", "invalid_reviewer_outputs"],
      "properties": {
        "packet_hash_consistent": {
          "description": "true only if every reviewer's packet_sha256 equals packet.sha256. false means the run fails closed: it is retained but not scored.",
          "type": "boolean"
        },
        "unverified_quote_finding_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "uniqueItems": true },
        "invalid_reviewer_outputs": {
          "description": "Reviewer outputs that did not parse or did not fit the output format. Retained here, never silently dropped.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer_id", "reason"],
            "properties": {
              "reviewer_id": { "$ref": "#/$defs/token" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "record_status": { "const": "study_record" } } },
      "then": { "properties": { "study_context": { "type": "object" } } }
    },
    {
      "if": { "properties": { "record_status": { "const": "illustrative_example" } } },
      "then": { "properties": { "study_context": { "type": "null" } } }
    }
  ],
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
    "case_id": { "type": "string", "pattern": "^PC-(F[0-9]{2}|TOY-[0-9]{2})$" },
    "source_id": { "type": "string", "pattern": "^(S|T)[0-9]+$" },
    "segment_id": { "type": "string", "pattern": "^(A[0-9]+|(S|T)[0-9]+\\.[0-9]+)$" },
    "transformation_id": { "type": "string", "pattern": "^X[0-9]+$" },
    "severity": {
      "description": "decisive: if correct, the presented reasons do not support the conclusion at its stated strength and scope. material: substantially weakens support. minor: real but does not change the support assessment. note: suggestion or observation, not a defect.",
      "enum": ["decisive", "material", "minor", "note"]
    },
    "support_assessment": {
      "description": "How well the presented reasons and evidence support the subject's conclusion. Not a judgment of whether the conclusion is true.",
      "enum": [
        "adequately_supported_as_scoped",
        "supported_at_reduced_strength_or_scope",
        "not_supported_by_presented_reasons",
        "undermined_by_presented_evidence",
        "framework_dependent",
        "indeterminate"
      ]
    },
    "independence_class": {
      "enum": ["same_context", "context_isolated_model_shared", "model_diverse", "human_independent", "unknown"]
    },
    "fidelity_check": {
      "enum": ["none", "self_reported", "independent_spot_check", "independent_full_check"]
    },
    "standing_effect": {
      "enum": ["modality_raised", "conditions_dropped", "limitations_dropped", "scope_widened", "attribution_dropped", "other"]
    }
  }
}
