{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pc-eer-0.2.schema.json",
  "title": "Philosophical Council epistemic evaluation record (pc-eer/0.2, proposed)",
  "description": "Proposed, not accepted. Structural schema for one critique of one case packet by one study condition. It constrains structure and metadata only: field presence, closed vocabularies, constants, identifiers and absence tags. It does not constrain what free-text fields say (interpretation, rationale, supportable_reformulation, verification_requests, note, justification), so prose can still assert truth, safety, intent or authority; that is detected only by human scoring. Cross-record rules are in epistemic-evaluation-record.md section 6 and validation/validate.py. Absence follows the REA v0.1 Stage B rule: no universal null; a field may use only the absence tags its contract names, and optional absence is omission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_format",
    "record_id",
    "record_status",
    "created_at",
    "non_claims",
    "study_context",
    "packet",
    "lineage",
    "reviewers",
    "findings",
    "reviewer_assessments",
    "synthesis",
    "integrity"
  ],
  "properties": {
    "record_format": { "const": "pc-eer/0.2-proposed" },
    "record_id": { "$ref": "#/$defs/token" },
    "record_status": {
      "enum": ["illustrative_example", "study_record"],
      "description": "illustrative_example: hand-written to explain the format; contains no model output and is not a result."
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "non_claims": {
      "description": "Constant metadata stating what the record does not assess. The constants bound the record's structured fields; they do not and cannot constrain free text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["truth", "safety", "intent", "authority", "representation"],
      "properties": {
        "truth": { "const": "not_assessed" },
        "safety": { "const": "not_assessed" },
        "intent": { "const": "not_assessed" },
        "authority": { "const": "none" },
        "representation": { "const": "none" }
      }
    },
    "study_context": {
      "description": "not_applicable only for illustrative examples.",
      "oneOf": [
        { "const": "not_applicable" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["study_id", "protocol_revision", "condition", "replicate"],
          "properties": {
            "study_id": { "$ref": "#/$defs/token" },
            "protocol_revision": { "type": "string", "minLength": 1 },
            "condition": { "enum": ["C0", "C1", "C2", "C3", "C4"] },
            "replicate": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "packet": {
      "description": "Identity of the exact case packet bytes every reviewer received (REA artifact content identity). The subject is segment family A inside this packet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "path", "sha256"],
      "properties": {
        "case_id": { "$ref": "#/$defs/case_id" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "transformations"],
      "properties": {
        "declared": {
          "description": "Mechanical projection of the packet's declared derived_from metadata. Declared lineage is a source assertion, not verified dependence.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "derived_from", "declared_roots"],
            "properties": {
              "source_id": { "$ref": "#/$defs/source_id" },
              "derived_from": { "type": "array", "items": { "$ref": "#/$defs/source_id" }, "uniqueItems": true },
              "declared_roots": { "type": "array", "items": { "$ref": "#/$defs/source_id" }, "uniqueItems": true, "minItems": 1 }
            }
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transformation_id", "output_id", "standing_ceiling_source_ids", "fidelity_check", "standing_effects_reported"],
            "properties": {
              "transformation_id": { "$ref": "#/$defs/transformation_id" },
              "output_id": { "$ref": "#/$defs/source_id" },
              "standing_ceiling_source_ids": {
                "description": "The output may not carry more evidentiary standing than these sources.",
                "type": "array",
                "items": { "$ref": "#/$defs/source_id" },
                "minItems": 1,
                "uniqueItems": true
              },
              "fidelity_check": { "$ref": "#/$defs/fidelity_check" },
              "standing_effects_reported": {
                "description": "Effects reviewers reported, each tied to the findings that reported it. Empty means none was reported, not that none occurred.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["effect", "finding_ids"],
                  "properties": {
                    "effect": { "$ref": "#/$defs/standing_effect" },
                    "finding_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "kind",
          "procedure",
          "model",
          "independence_class",
          "packet_sha256",
          "prompt_sha256",
          "output_sha256",
          "budget",
          "submitted_before_synthesis"
        ],
        "properties": {
          "reviewer_id": { "$ref": "#/$defs/token" },
          "kind": { "enum": ["model", "human", "illustrative_placeholder"] },
          "procedure": {
            "description": "generic: ordinary critique (C1, C3). O1..O6: one operator (C4). O1-O6_sequential: all operators in one context (C2). naive: C0 exploratory baseline.",
            "enum": ["generic", "naive", "O1", "O2", "O3", "O4", "O5", "O6", "O1-O6_sequential"]
          },
          "model": {
            "description": "Immutable model identity; mutable aliases may appear only as supplementary labels. not_applicable for human and placeholder reviewers.",
            "oneOf": [
              { "const": "not_applicable" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "exact_version", "alias_labels", "settings"],
                "properties": {
                  "family": { "type": "string", "minLength": 1 },
                  "exact_version": { "type": "string", "minLength": 1 },
                  "alias_labels": { "type": "array", "items": { "type": "string" } },
                  "settings": {
                    "description": "Sampling and reasoning settings, values recorded as strings.",
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            ]
          },
          "independence_class": { "$ref": "#/$defs/independence_class" },
          "packet_sha256": { "$ref": "#/$defs/sha256" },
          "prompt_sha256": { "$ref": "#/$defs/sha256_or_not_applicable" },
          "output_sha256": { "$ref": "#/$defs/sha256_or_not_applicable" },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_output_tokens", "used_output_tokens", "used_input_tokens"],
            "properties": {
              "max_output_tokens": { "$ref": "#/$defs/count_or_tag" },
              "used_output_tokens": { "$ref": "#/$defs/count_or_tag" },
              "used_input_tokens": { "$ref": "#/$defs/count_or_tag" }
            }
          },
          "submitted_before_synthesis": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "model" } } },
            "then": { "properties": { "model": { "type": "object" } } }
          },
          {
            "if": { "properties": { "kind": { "enum": ["human", "illustrative_placeholder"] } } },
            "then": { "properties": { "model": { "const": "not_applicable" } } }
          }
        ]
      }
    },
    "findings": {
      "description": "Every finding exactly as reported, attributed to one reviewer. No deduplication or rewording. In REA terms each finding is an interpretation derived from the quoted segments.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "reviewer_id", "segments", "quotations", "interpretation", "severity", "reported_confidence_pct", "verification_requests"],
        "properties": {
          "finding_id": { "$ref": "#/$defs/token" },
          "reviewer_id": { "$ref": "#/$defs/token" },
          "segments": { "type": "array", "items": { "$ref": "#/$defs/segment_id" }, "minItems": 1, "uniqueItems": true },
          "quotations": {
            "description": "The reviewer's citations of packet text. A quotation is a claim about what the packet says; the validator's byte-exact check of it is the observation, and source_verification records that check's result.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segment_id", "quote", "source_verification"],
              "properties": {
                "segment_id": { "$ref": "#/$defs/segment_id" },
                "quote": { "type": "string", "minLength": 1 },
                "source_verification": {
                  "description": "REA v0.1 section 5.4 values. source_linked: the quote is an exact substring of the cited segment. source_mismatch: the cited segment does not contain it, or does not exist. unverified: not yet checked.",
                  "enum": ["source_linked", "source_mismatch", "unverified"]
                }
              }
            }
          },
          "interpretation": { "type": "string", "minLength": 1 },
          "severity": { "$ref": "#/$defs/severity" },
          "reported_confidence_pct": { "$ref": "#/$defs/reported_pct" },
          "verification_requests": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "reviewer_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "support_assessment", "reported_confidence_pct", "rationale"],
        "properties": {
          "reviewer_id": { "$ref": "#/$defs/token" },
          "support_assessment": { "$ref": "#/$defs/support_assessment" },
          "reported_confidence_pct": { "$ref": "#/$defs/reported_pct" },
          "rationale": { "type": "string", "minLength": 1 },
          "supportable_reformulation": {
            "description": "Optional; omitted when the reviewer offered none.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "synthesis": {
      "description": "In REA terms a derived analysis: a regenerable projection of the findings and assessments, never canonical evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "positions",
        "unresolved_disagreements",
        "segment_attention",
        "agreement_is_not_corroboration",
        "dropped_positions",
        "synthesized_confidence"
      ],
      "properties": {
        "method": { "enum": ["single_reviewer", "mechanical_union", "model_synthesis"] },
        "positions": {
          "description": "Every distinct reviewer support assessment, with who holds it. Listing a position retains it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position_id", "support_assessment", "held_by"],
            "properties": {
              "position_id": { "$ref": "#/$defs/token" },
              "support_assessment": { "$ref": "#/$defs/support_assessment" },
              "held_by": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true }
            }
          }
        },
        "unresolved_disagreements": {
          "description": "REA-style discrepancies between positions (kind conflicting_claims, or an integrity discrepancy). Always open here: synthesis never adjudicates; resolution needs a separate adjudication record.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disagreement_id", "position_ids", "type", "status"],
            "properties": {
              "disagreement_id": { "$ref": "#/$defs/token" },
              "position_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 2, "uniqueItems": true },
              "type": {
                "description": "integrity_conflict: records inconsistent with each other (not an opinion). reasoned / framework_dependent: competing assessments, both retained. unclassified: mechanical synthesis does not classify.",
                "enum": ["unclassified", "reasoned", "framework_dependent", "integrity_conflict"]
              },
              "status": { "const": "open" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "segment_attention": {
          "description": "Which reviewers cited each segment. A count of reviewers is attention, not corroboration.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "reviewer_ids", "independence_classes"],
            "properties": {
              "segment_id": { "$ref": "#/$defs/segment_id" },
              "reviewer_ids": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true },
              "independence_classes": { "type": "array", "items": { "$ref": "#/$defs/independence_class" }, "minItems": 1, "uniqueItems": true }
            }
          }
        },
        "agreement_is_not_corroboration": {
          "description": "Constant. Agreement among reviewers is never recorded as independent corroboration; a corroboration claim needs a separate dependence analysis.",
          "const": true
        },
        "dropped_positions": {
          "description": "Must be empty for single_reviewer and mechanical_union. For model_synthesis, any reviewer position missing from positions is listed here with a justification.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["support_assessment", "held_by", "justification"],
            "properties": {
              "support_assessment": { "$ref": "#/$defs/support_assessment" },
              "held_by": { "type": "array", "items": { "$ref": "#/$defs/token" }, "minItems": 1, "uniqueItems": true },
              "justification": { "type": "string", "minLength": 1 }
            }
          }
        },
        "synthesized_confidence": {
          "description": "Constant: confidence is never aggregated across reviewers, so agreement cannot inflate it.",
          "const": "not_aggregated"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_hash_consistent", "quotation_mismatch_finding_ids", "unverified_quotation_finding_ids", "unknown_segment_finding_ids", "invalid_reviewer_outputs"],
      "properties": {
        "packet_hash_consistent": {
          "description": "true only if every reviewer's packet_sha256 equals packet.sha256. false means the run fails closed: it is retained but not scored.",
          "type": "boolean"
        },
        "quotation_mismatch_finding_ids": {
          "description": "Findings with at least one quotation whose source_verification is source_mismatch. Warn-and-review: the finding is retained and flagged.",
          "type": "array", "items": { "$ref": "#/$defs/token" }, "uniqueItems": true
        },
        "unverified_quotation_finding_ids": {
          "description": "Findings with at least one quotation not yet checked. Not permitted in study records.",
          "type": "array", "items": { "$ref": "#/$defs/token" }, "uniqueItems": true
        },
        "unknown_segment_finding_ids": {
          "description": "Findings that cite a segment ID absent from the packet. Warn-and-review: the finding is retained and flagged.",
          "type": "array", "items": { "$ref": "#/$defs/token" }, "uniqueItems": true
        },
        "invalid_reviewer_outputs": {
          "description": "Reviewer outputs that did not parse or did not fit the output format. Retained here, never silently dropped.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer_id", "reason"],
            "properties": {
              "reviewer_id": { "$ref": "#/$defs/token" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "record_status": { "const": "illustrative_example" } } },
      "then": { "properties": { "study_context": { "const": "not_applicable" } } }
    },
    {
      "if": { "properties": { "record_status": { "const": "study_record" } } },
      "then": {
        "properties": {
          "study_context": { "type": "object" },
          "reviewers": {
            "items": {
              "properties": {
                "kind": { "enum": ["model", "human"] },
                "prompt_sha256": { "$ref": "#/$defs/sha256" },
                "output_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "findings": {
            "items": {
              "properties": {
                "quotations": {
                  "items": { "properties": { "source_verification": { "enum": ["source_linked", "source_mismatch"] } } }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256_or_not_applicable": {
      "description": "not_applicable only where the record status permits it (illustrative examples).",
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": "not_applicable" }]
    },
    "count_or_tag": {
      "description": "unknown: the provider or harness did not report the value. not_applicable: no call was made (illustrative examples, human reviewers).",
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "enum": ["unknown", "not_applicable"] }]
    },
    "reported_pct": {
      "description": "The reviewer's self-reported confidence, recorded as a measured value. It is not a confidence classification of the record (REA v0.1 section 6) and promotes nothing.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "case_id": { "type": "string", "pattern": "^PC-(F[0-9]{2}|TOY-[0-9]{2})$" },
    "source_id": { "type": "string", "pattern": "^(S|T)[0-9]+$" },
    "segment_id": { "type": "string", "pattern": "^(A[0-9]+|(S|T)[0-9]+\\.[0-9]+)$" },
    "transformation_id": { "type": "string", "pattern": "^X[0-9]+$" },
    "severity": {
      "description": "decisive: if correct, the presented reasons do not support the conclusion at its stated strength and scope. material: substantially weakens support. minor: real but does not change the support assessment. note: suggestion or observation, not a defect.",
      "enum": ["decisive", "material", "minor", "note"]
    },
    "support_assessment": {
      "description": "How well the presented reasons and evidence support the subject's conclusion. Not a judgment of whether the conclusion is true, and not an REA evaluation (which assesses a hypothesis or theory).",
      "enum": [
        "adequately_supported_as_scoped",
        "supported_at_reduced_strength_or_scope",
        "not_supported_by_presented_reasons",
        "undermined_by_presented_evidence",
        "framework_dependent",
        "indeterminate"
      ]
    },
    "independence_class": {
      "enum": ["same_context", "context_isolated_model_shared", "model_diverse", "human_independent", "unknown"]
    },
    "fidelity_check": {
      "enum": ["none", "self_reported", "independent_spot_check", "independent_full_check"]
    },
    "standing_effect": {
      "enum": ["modality_raised", "conditions_dropped", "limitations_dropped", "scope_widened", "attribution_dropped", "other"]
    }
  }
}
